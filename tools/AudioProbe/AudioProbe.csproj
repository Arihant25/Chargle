<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Chargle.AudioProbe</RootNamespace>
    <AssemblyName>AudioProbe</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!--
    Links the real audio sources rather than copying them, so this exercises exactly the code
    the app ships. A bug that reproduces here is in Chargle; one that does not is in the WinUI
    host around it.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Chargle\Services\AudioEngine.cs" Link="AudioEngine.cs" />
    <Compile Include="..\..\src\Chargle\Services\CachedSound.cs" Link="CachedSound.cs" />
    <Compile Include="..\..\src\Chargle\Services\Presence.cs" Link="Presence.cs" />
  </ItemGroup>

</Project>
