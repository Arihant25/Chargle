<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Chargle's visual vocabulary is deliberately small: one card, one section header, one
        muted caption. Windows 11 already has excellent type and colour ramps, so this file
        mostly declines to invent alternatives to them.
    -->

    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>

    <!--
        The Chargle bolt, in the same coordinates the icon generator uses, so the mark in the
        window and the mark on the taskbar are literally the same shape rather than two drawings
        that happen to look alike.
    -->
    <x:String x:Key="BoltGeometry">M41.1,8 L4,55.3 L25.9,55.3 L20.9,92 L58,43 L36.1,43 Z</x:String>

    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="2,20,0,8" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        Every toggle in a settings row. The default ToggleSwitch reserves 154 pixels for a label
        it does not have here, which pushes it away from the right edge by a different amount
        depending on what else is in the row, so no two rows line up.
    -->
    <Style x:Key="RowToggleStyle" TargetType="ToggleSwitch">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Width" Value="46" />
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <!-- The standard settings row: a bordered surface with generous, even padding. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="16,13,16,13" />
    </Style>

</ResourceDictionary>
