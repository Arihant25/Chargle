<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Chargle.Views.BatteryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,20">
        <StackPanel Spacing="4">

            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="2,0,0,8"
                       Text="Two levels worth knowing about. Each one says its piece once per charge, not every time the reading twitches." />

            <!-- Charged -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="When the battery is charged" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="While the charger is connected." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Style="{StaticResource RowToggleStyle}"
                                      AutomationProperties.Name="Announce when the battery is charged"
                                      IsOn="{x:Bind Vm.FullChargeEnabled, Mode=TwoWay}" />
                    </Grid>

                    <StackPanel Spacing="14" Visibility="{x:Bind ShowIf(Vm.FullChargeEnabled), Mode=OneWay}">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Slider Grid.Column="0" Minimum="50" Maximum="100" StepFrequency="5"
                                    AutomationProperties.Name="Battery level to announce at"
                                    Value="{x:Bind Vm.FullChargePercent, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" MinWidth="42" TextAlignment="Right"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="{x:Bind Percent(Vm.FullChargePercent), Mode=OneWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,190" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="How it tells you" />
                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                           Text="{x:Bind AlertDescription(Vm.FullChargeAlertIndex), Mode=OneWay}" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="How the charged milestone tells you"
                                SelectedIndex="{x:Bind Vm.FullChargeAlertIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Chime" />
                                <ComboBoxItem Content="Show a panel" />
                                <ComboBoxItem Content="Both" />
                            </ComboBox>
                        </Grid>

                        <!-- No sound row when the milestone only shows a panel. A sound picker
                             that changes nothing is worse than no sound picker. -->
                        <Grid ColumnDefinitions="*,190,Auto" ColumnSpacing="12"
                              Visibility="{x:Bind ShowIf(Vm.FullChargeMakesSound), Mode=OneWay}">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Sound" />
                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                           Text="The rising half of a pack. Nothing to do with what the charger plays." />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                ItemsSource="{x:Bind Vm.MilestoneSoundOptions}"
                                AutomationProperties.Name="Sound for the charged milestone"
                                SelectedIndex="{x:Bind Vm.FullChargeSoundIndex, Mode=TwoWay}" />
                            <Button
                                Grid.Column="2"
                                Width="36" Height="32" Padding="0"
                                VerticalAlignment="Center"
                                Click="OnPreviewFull"
                                AutomationProperties.Name="Hear the charged sound"
                                ToolTipService.ToolTip="Hear it">
                                <FontIcon FontSize="12" Glyph="&#xE768;" />
                            </Button>
                        </Grid>

                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Low -->
            <Border Style="{StaticResource CardStyle}" Margin="0,4,0,0">
                <StackPanel Spacing="14">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="When the battery runs low" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="Only while running on battery." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Style="{StaticResource RowToggleStyle}"
                                      AutomationProperties.Name="Announce when the battery runs low"
                                      IsOn="{x:Bind Vm.LowBatteryEnabled, Mode=TwoWay}" />
                    </Grid>

                    <StackPanel Spacing="14" Visibility="{x:Bind ShowIf(Vm.LowBatteryEnabled), Mode=OneWay}">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Slider Grid.Column="0" Minimum="5" Maximum="50" StepFrequency="5"
                                    AutomationProperties.Name="Low battery level to announce at"
                                    Value="{x:Bind Vm.LowBatteryPercent, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" MinWidth="42" TextAlignment="Right"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="{x:Bind Percent(Vm.LowBatteryPercent), Mode=OneWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,190" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="How it tells you" />
                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                           Text="{x:Bind AlertDescription(Vm.LowBatteryAlertIndex), Mode=OneWay}" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="How the low battery milestone tells you"
                                SelectedIndex="{x:Bind Vm.LowBatteryAlertIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Chime" />
                                <ComboBoxItem Content="Show a panel" />
                                <ComboBoxItem Content="Both" />
                            </ComboBox>
                        </Grid>

                        <Grid ColumnDefinitions="*,190,Auto" ColumnSpacing="12"
                              Visibility="{x:Bind ShowIf(Vm.LowBatteryMakesSound), Mode=OneWay}">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Sound" />
                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                           Text="The falling half of a pack. Nothing to do with what the charger plays." />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                ItemsSource="{x:Bind Vm.MilestoneSoundOptions}"
                                AutomationProperties.Name="Sound for the low battery milestone"
                                SelectedIndex="{x:Bind Vm.LowBatterySoundIndex, Mode=TwoWay}" />
                            <Button
                                Grid.Column="2"
                                Width="36" Height="32" Padding="0"
                                VerticalAlignment="Center"
                                Click="OnPreviewLow"
                                AutomationProperties.Name="Hear the low battery sound"
                                ToolTipService.ToolTip="Hear it">
                                <FontIcon FontSize="12" Glyph="&#xE768;" />
                            </Button>
                        </Grid>

                    </StackPanel>

                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="2,10,0,0"
                       Text="A panel shown here takes its look and position from On screen. Milestones stay quiet during Do Not Disturb if that rule is switched on under Rules." />

        </StackPanel>
    </ScrollViewer>
</Page>
