<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Chargle.Views.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,20">
        <StackPanel Spacing="4">

            <TextBlock Style="{StaticResource MutedTextStyle}" Margin="2,0,0,8" Text="When Chargle speaks up, and when it keeps out of the way." />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="The charger is connected" />
                    <ToggleSwitch Grid.Column="1" Style="{StaticResource RowToggleStyle}" AutomationProperties.Name="The charger is connected" IsOn="{x:Bind Vm.PlayOnPlug, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,4,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="The charger is disconnected" />
                    <ToggleSwitch Grid.Column="1" Style="{StaticResource RowToggleStyle}" AutomationProperties.Name="The charger is disconnected" IsOn="{x:Bind Vm.PlayOnUnplug, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,4,0,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Stay quiet when you are busy" />
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   Text="Silent during Do Not Disturb, screen sharing and full-screen apps. Applies to the on-screen panel too." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" Style="{StaticResource RowToggleStyle}" AutomationProperties.Name="Stay quiet when you are busy" IsOn="{x:Bind Vm.RespectDoNotDisturb, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Expander
                Margin="0,10,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="Battery milestones">
                <StackPanel Spacing="16" Padding="0,4,0,4">

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Chime when the battery is charged" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="Once per charge, not every time the level twitches." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Style="{StaticResource RowToggleStyle}" AutomationProperties.Name="Chime when the battery is charged" IsOn="{x:Bind Vm.FullChargeEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Visibility="{x:Bind ShowIf(Vm.FullChargeEnabled), Mode=OneWay}">
                        <Slider Grid.Column="0" Minimum="50" Maximum="100" StepFrequency="5" AutomationProperties.Name="Battery level to chime at" Value="{x:Bind Vm.FullChargePercent, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" MinWidth="42" TextAlignment="Right"
                                   Style="{StaticResource MutedTextStyle}" Text="{x:Bind Percent(Vm.FullChargePercent), Mode=OneWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Chime when the battery runs low" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="Only while running on battery." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Style="{StaticResource RowToggleStyle}" AutomationProperties.Name="Chime when the battery runs low" IsOn="{x:Bind Vm.LowBatteryEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Visibility="{x:Bind ShowIf(Vm.LowBatteryEnabled), Mode=OneWay}">
                        <Slider Grid.Column="0" Minimum="5" Maximum="50" StepFrequency="5" AutomationProperties.Name="Low battery level to chime at" Value="{x:Bind Vm.LowBatteryPercent, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" MinWidth="42" TextAlignment="Right"
                                   Style="{StaticResource MutedTextStyle}" Text="{x:Bind Percent(Vm.LowBatteryPercent), Mode=OneWay}" />
                    </Grid>

                </StackPanel>
            </Expander>

            <Expander
                Margin="0,4,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="Startup and speed">
                <StackPanel Spacing="16" Padding="0,4,0,4">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Start with Windows" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{x:Bind Vm.RunAtLoginDetail, Mode=OneWay}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Style="{StaticResource RowToggleStyle}"
                                      IsEnabled="{x:Bind Not(Vm.RunAtLoginBlocked), Mode=OneWay}"
                                      AutomationProperties.Name="Start with Windows" IsOn="{x:Bind Vm.RunAtLogin, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Start hidden in the tray" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="No window when Windows starts Chargle for you." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Style="{StaticResource RowToggleStyle}" AutomationProperties.Name="Start hidden in the tray" IsOn="{x:Bind Vm.StartHidden, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Instant mode" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{x:Bind Vm.InstantModeDetail, Mode=OneWay}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Style="{StaticResource RowToggleStyle}" AutomationProperties.Name="Instant mode" IsOn="{x:Bind Vm.InstantMode, Mode=TwoWay}" />
                    </Grid>

                </StackPanel>
            </Expander>

            <TextBlock
                Margin="2,14,0,0"
                Style="{StaticResource MutedTextStyle}"
                Visibility="{x:Bind ShowIfText(Vm.Reaction), Mode=OneWay}"
                Text="{x:Bind Vm.Reaction, Mode=OneWay}" />

        </StackPanel>
    </ScrollViewer>
</Page>
