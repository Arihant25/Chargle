<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Chargle.Views.IndicatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="10" />
        </Grid.RenderTransform>

        <Grid
            x:Name="Layout"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="14"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Border
                x:Name="Badge"
                Grid.Column="0"
                VerticalAlignment="Center">
                <Viewbox x:Name="BoltBox" Width="16" Height="18">
                    <Path x:Name="Bolt" Data="{StaticResource BoltGeometry}" />
                </Viewbox>
            </Border>

            <StackPanel x:Name="Words" Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                <!--
                    NoWrap is load bearing. The window is sized from what this content asks for,
                    so if the text is allowed to wrap it reports a tall narrow size, the window
                    is made that shape, and the text then wraps for real and is clipped.
                -->
                <TextBlock
                    x:Name="Headline"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    TextWrapping="NoWrap" />
                <TextBlock
                    x:Name="Detail"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="NoWrap" />
            </StackPanel>

        </Grid>
    </Grid>
</Window>
