<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Chargle.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,20">
        <StackPanel Spacing="4">

            <Border Style="{StaticResource CardStyle}" Padding="18,18,18,18">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Border
                        Grid.Column="0"
                        Width="56" Height="56"
                        CornerRadius="15"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <Viewbox Width="24" Height="27">
                            <Path Data="{StaticResource BoltGeometry}" Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Chargle" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="{x:Bind VersionLine}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource MutedTextStyle}"
                            Text="Hear when your laptop starts and stops charging. Windows never did this on its own, so here it is." />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                            <Button Click="OnOpenRepo" Content="GitHub" />
                            <Button Click="OnOpenWebsite" Content="arihant25.github.io" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                <Grid ColumnDefinitions="*,190" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Theme" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="Applies to this window and the on-screen panel." />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Theme" SelectedIndex="{x:Bind Vm.ThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Follow Windows" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,4,0,0">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Licence" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="{x:Bind CopyrightLine}" />
                    <TextBlock
                        Style="{StaticResource MutedTextStyle}"
                        Text="Released under the MIT licence. Free to use, change and redistribute, including commercially, as long as the copyright notice goes with it." />
                    <HyperlinkButton Padding="0,4,0,0" Click="OnOpenLicence" Content="Read the licence" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,4,0,0">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Built with" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Windows App SDK and WinUI 3, from Microsoft." />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="NAudio by Mark Heath, for the WASAPI output. MIT licensed." />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="The sounds and the icon are generated by code in the repository, so they carry the same licence as the app." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,4,0,0">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Where things live" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" IsTextSelectionEnabled="True" Text="{x:Bind SettingsPath}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" IsTextSelectionEnabled="True" Text="{x:Bind SoundsPath}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource MutedTextStyle}"
                        Text="Chargle makes no network requests and collects nothing." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
